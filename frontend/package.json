{
  "name": "aqp-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "style:check": "node scripts/check-style.mjs",
    "style:check:no-hex": "node scripts/check-style.mjs --no-hex",
    "nav:check": "node scripts/check-nav-integrity.mjs",
    "preview": "vite preview --port 4173",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dayjs": "1.11.13",
    "echarts": "5.5.1",
    "lightweight-charts": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.6",
    "swr": "^2.5.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.12",
    "typescript": "5.5.4",
    "vite": "5.4.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
