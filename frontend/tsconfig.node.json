{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    // 编译产物输出到临时目录：避免生成 frontend/vite.config.js，
    // 否则 Vite 会优先加载 .js（优先级高于 .ts），导致 .ts 里的配置被静默遮蔽
    "outDir": "./node_modules/.tmp/tsconfig.node"
  },
  "include": ["vite.config.ts"]
}
