# ============================================================
# AQP 全局环境变量模板。部署时复制为 .env 并修改。
# ============================================================

# ---------- 基础 ----------
APP_NAME=AQP
ENV=dev
DEBUG=true
# 后台管理接口 Bearer Token；生产环境必须改为强随机串
ADMIN_TOKEN=aqp-dev-token-change-me

# ---------- 网络 ----------
API_HOST=0.0.0.0
API_PORT=8000
# 逗号分隔的前端跨域地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- SQLite ----------
# 默认指向 <项目根>/data/sqlite/aqp.db，一般无需修改
# SQLITE_URL=sqlite+aiosqlite:///D:\Python_Project\Alpha Quant Platform\data\sqlite\aqp.db

# ---------- Redis ----------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Redis 密码：必须与 Redis 容器 --requirepass 一致（docker-compose.yml 从本文件读取）；
# compose 用 ${REDIS_PASSWORD:?...} 做必填校验，缺省会直接报错而非静默起无密码实例
REDIS_PASSWORD=123456
REDIS_TIMEOUT=1.0

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- AKShare ----------
AKSHARE_RATE_LIMIT=1.2
AKSHARE_RETRY=3

# ---------- ML ----------
ML_LABEL_HORIZON=5
ML_HOLDOUT_DAYS=252

TZ=Asia/Shanghai
