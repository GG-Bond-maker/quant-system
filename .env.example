# ============================================================
# AQP 全局环境变量模板。部署时复制为 .env 并修改。
# ============================================================

# ---------- 基础 ----------
APP_NAME=AQP
ENV=dev
DEBUG=true
# 后台管理兼容 Bearer Token；生产环境必须改为强随机串。
# 前端登录页使用用户名/密码换取 JWT，不要将此值粘贴到登录页。
ADMIN_TOKEN=aqp-dev-token-change-me
# 是否允许 ADMIN_TOKEN 直接作为登录凭据；生产环境必须为 false。
ALLOW_ADMIN_TOKEN_LOGIN=true
# JWT 签名密钥；生产环境必须独立设置至少 32 位的随机值。
JWT_SECRET=
JWT_EXPIRE_SECONDS=604800
# 是否显示并开放自助注册；生产环境必须为 false。
ALLOW_REGISTRATION=true
# 自助注册的默认角色：viewer 或 researcher；管理员仅能由 create_admin.py 创建。
REGISTER_DEFAULT_ROLE=viewer

# ---------- 网络 ----------
API_HOST=0.0.0.0
API_PORT=8000
# 逗号分隔的前端跨域地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Prometheus /metrics 是否要求 Bearer 认证；留空（不设置）时：prod 要求认证、dev/test 保持开放。
# 显式 true/false 可覆盖该默认策略。
# METRICS_REQUIRE_AUTH=

# ---------- SQLite ----------
# 默认指向 <项目根>/data/sqlite/aqp.db，一般无需修改
# SQLITE_URL=sqlite+aiosqlite:///D:\Python_Project\Alpha Quant Platform\data\sqlite\aqp.db

# ---------- Redis ----------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Redis 密码：必须与 Redis 容器 --requirepass 一致（docker-compose.yml 从本文件读取）；
# compose 用 ${REDIS_PASSWORD:?...} 做必填校验，缺省会直接报错而非静默起无密码实例
REDIS_PASSWORD=123456
REDIS_TIMEOUT=1.0

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- AKShare ----------
AKSHARE_RATE_LIMIT=1.2
AKSHARE_RETRY=3
# 启动时是否预热 market/overview。无 Redis 时首次构建需 48s+ 外部聚合，
# 测试环境必须设为 0（tests/conftest.py 依赖 WARM_OVERVIEW_ON_STARTUP=0）。
WARM_OVERVIEW_ON_STARTUP=1

# ---------- 面板超时 / 计算资源 ----------
# 个股详情面板单块超时上限（秒）：8 块并发构建，外部源慢/挂起时该块降级为
# unavailable，其余块正常返回，保证 /panels 响应时间有界。
# ⚠️ 默认值本轮由 20 调整为 4.5（前端交互预算）；需要更宽容可显式覆盖。
# AQP_PANEL_BLOCK_TIMEOUT=4.5
# 重计算并发满额时的有界等待秒数：窗口内排队等待空闲 slot，超时才返回 40103
# ERR_RATE_LIMITED；配合前端 ComputeQueue 串行化，避免「前端排好队、后端仍直接拒」。
COMPUTE_ACQUIRE_TIMEOUT_SECONDS=10.0

# ---------- 数据 / 特征版本 ----------
# features 版本号。留空（不设置）时按 parquet mtime 隐式选择最新单一版本，
# 自动选择会记 WARNING；但口径可能随新版本写入而静默切换，生产建议显式固定。
# FEATURE_VERSION=alpha_basic_v2g

# ---------- ML ----------
ML_LABEL_HORIZON=5
ML_HOLDOUT_DAYS=252

TZ=Asia/Shanghai
