# 本地探查脚本目录与 pytest 运行垫片（.tmp_testrun 是 PYTHONPATH shim，非源码）
backend/.tmp_*/
# 浏览器 QA 截图/DOM 快照产物
qa_browser/
# 数据清洗归档（P0-4 前置：2022 年前 parquet 已移出生产目录，仅留档）
data/_purged_*/
# AI 助手工作区
.workbuddy-ai/

# ============= 依赖安全升级临时产物（2026-09-29 全检 P1-A2） =============
# pip --target 暂存目录（升级用，非源码）
backend/.stage_upgrade/
# 升级前的依赖快照与 site-packages 备份（本机回滚用，非源码）
backend/.req_backup_*/

# ============= 备份/清理产物（2026-09-30 A6 git 恢复时补登） =============
# 与既有 `data/backup_*/` 同约定：**备份不入库**（二进制归档会污染历史、无法 diff）
.cleanup_backup_*/
backup/

# ============= 临时/诊断产物（2026-09-30 清理后补登，防复发） =============
# ⚠️ 注意：既有的 `backend/.tmp_*/` 带尾斜杠 ⇒ 只匹配**目录**，不匹配文件。
# 下面用**无尾斜杠**写法，同时覆盖文件与目录。
backend/.tmp_*
# QA / 验证过程产物（脚本保留，仅忽略其输出）
backend/tests/_qa_*.txt
docs/audit/_verify_err*.txt
docs/audit/**/_verify_*_out.txt
# 源文件的一次性备份副本
.bugfix_backup/

# ============= 凭据与一次性探针产物（2026-10-01 提交前拦截） =============
# 🔴 诊断时抓的真实 JWT（admin 角色）曾落在 deliverables/gstack/_tmp/ 下。
#    token 是**真实可用凭据**，入库即等于把 admin 凭据写进历史（不可撤销）。
#    一律忽略：文件名/后缀双覆盖，避免下次换个名字又漏。
*.tok
tok.txt
token.txt
*_token.txt
*_tok.txt
# 探针/诊断的临时进度与中间产物（脚本保留，产物不入库）
backend/tmp_probe/*.json
deliverables/gstack/_tmp/*.json

# 恢复过程产生的 .git 备份（2026-10-01，误入首次提交后移除）
.git-broken*/

# ============= 审计/运行时临时产物（2026-10-04 提交前拦截） =============
# QA 审计工作区（mypy cache / 日志 / mkdtemp 工作区 / parquet 副本，实测 138 MB）
.qa_audit_tmp/
# rwlock 压测垫片目录（脚本保留，产物不入库；注意根锚定，与 backend/.tmp_* 不同层）
.tmp_bench_*/
# 根目录的一次性诊断输出（`_` 前缀 scratch 文本；仓库内无任何以 `_` 开头的已跟踪文件）
/_*.txt
# 后端全量测试的原始输出留档（运行时产物）
backend/_*.txt
# 扩容脚本断点续传状态的**泛化**（既有 `**/.expand_2500_state.json` 只覆盖单名，
# 实测漏出 .expand_2022 / _2022r2 / _2022r3 / _full / _smoke 五个变体）
**/.expand_*_state.json

# ============= 本地 DSH 沙箱脚手架（2026-10-04 提交前拦截） =============
# ⚠️ 本机 DSH 沙箱下，运行时新建的目录会被 ACL 拒绝
#    （PermissionError [WinError 5]），故改用**预建目录池**。它是纯本地运行环境
#    适配，CI 不需要，也不属于产品源码；实测该目录会累积约 20 个 pytest 临时
#    工作区（aqp_test_* / aqp_probe_* / pool_*）。
.dsh_tmp/
# 同因：把 pytest 的临时目录重定向到上面那个目录池的**本地垫片**。
# 其模块 docstring 已声明「仅本地 DSH 沙箱，CI 不需要」；入库只会给 CI 多带一份
# 无人引用的文件（且它反过来依赖本机路径约定）。
backend/tests/_sandbox_pytest_runner.py
